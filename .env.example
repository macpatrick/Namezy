# Copy this file to `.env` and fill in what you have. python-dotenv is not
# used here to keep the dependency list minimal -- either export these in
# your shell before running the app, or use `set -a; source .env; set +a`.

# --- Google Custom Search API (Validation step: web-conflict check) -------
# Confirmed unavailable as of 2026-07-14: Google's Custom Search JSON API is
# closed to new customers -- any newly created Cloud project gets a 403 no
# matter the account/org/billing setup. Not a config problem, don't spend
# time debugging a 403 here -- see the build report for the investigation.
# Left blank; the web-conflict check gracefully reports "not_configured"
# without these. Only usable again with a grandfathered pre-closure key, or
# by swapping validation.py's check_web_conflict() to a different provider
# (e.g. Serper.dev, Brave Search API).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Optional tuning ---------------------------------------------------
# Claude model for the Brand Strategist + Name Generator steps.
# Defaults to Sonnet -- cheaper than Opus with little quality loss for this
# workload (200 short structured-JSON name candidates per run). Bump to
# claude-opus-4-8 if you want higher-quality candidates and don't mind the cost.
NAMEZY_CLAUDE_MODEL=claude-sonnet-5

# How many candidate names to ask Claude to generate per run (brief scope: 100-300).
# NAMEZY_CANDIDATE_COUNT=200

# How many top-scored candidates get a Google Custom Search check (free tier
# is 100 queries/day) -- the rest are left unchecked rather than burning quota.
# GOOGLE_CSE_MAX_CHECKS=50

# Override the SQLite database file location (defaults to ./namezy.db).
# NAMEZY_DB_PATH=./namezy.db

# --- Claude API key -----------------------------------------------------
# REQUIRED. The Anthropic Python SDK has no automatic auth -- it only reads
# this env var (or an explicit api_key= argument). Get a key from
# https://console.anthropic.com/ (API Keys) and paste it below.
ANTHROPIC_API_KEY=
